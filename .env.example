# Токен SourceCraft здесь не хранится: он лежит в системном хранилище (Keychain)
# и задаётся командой `sourcecraft-mcp connect`.

# Адрес SourceCraft API (по умолчанию публичный).
SOURCECRAFT_BASE_URL=https://api.sourcecraft.tech

# Уровень логов в stderr: error, warn, info, debug, trace.
SOURCECRAFT_MCP_LOG=warn
